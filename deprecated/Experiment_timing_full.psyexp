        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="staircase_name.addResponse(corr);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="if str(key_resp.keys) == str(corr_response):&amp;#10;    key_resp.corr = 1&amp;#10;else:&amp;#10;    key_resp.corr = 0&amp;#10;&amp;#10;thisExp.addData('gabor_angle', gabor_angle)&amp;#10;thisExp.addData('level', level)&amp;#10;thisExp.addData('jitter', jitter)&amp;#10;thisExp.addData('tiltDir', tiltDir)&amp;#10;thisExp.addData('key_resp.corr', key_resp.corr)&amp;#10;&amp;#10;# Per-block tracking&amp;#10;if key_resp.keys in ['', [], None]:&amp;#10;    expInfo[f'block_{current_block}_noresp'] += 1&amp;#10;else:&amp;#10;    expInfo[f'block_{current_block}_total'] += 1&amp;#10;    if key_resp.corr == 1:&amp;#10;        expInfo[f'block_{current_block}_correct'] += 1&amp;#10;&amp;#10;# Cumulative tracking&amp;#10;if key_resp.keys not in ['', [], None]:&amp;#10;    expInfo['total_trials'] += 1&amp;#10;    if key_resp.corr == 1:&amp;#10;        expInfo['total_correct'] += 1&amp;#10;else:&amp;#10;    expInfo['total_noresp'] += 1" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_4" valType="code" updates="None" name="name"/>
