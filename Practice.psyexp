      <CodeComponent name="code_7" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="import json&amp;#10;&amp;#10;# Get threshold angle&amp;#10;# Calculate threshold from the reversal intensities&amp;#10;if len(stair.reversalIntensities) &gt;= 2:&amp;#10;    threshold_angle = np.mean(stair.reversalIntensities[-6:])&amp;#10;else:&amp;#10;    threshold_angle = level  # fallback to last level if not enough reversals&amp;#10;&amp;#10;participant = expInfo['participant']&amp;#10;session = expInfo['session']&amp;#10;&amp;#10;# Only the third (final) session's threshold is taken as the participant's&amp;#10;# real threshold and written out for the main experiment to read&amp;#10;if session == '3':&amp;#10;    threshold_file = f'data/threshold_{participant}.json'&amp;#10;    threshold_data = {&amp;#10;        'threshold_angle': threshold_angle&amp;#10;    }&amp;#10;    with open(threshold_file, 'w') as f:&amp;#10;        json.dump(threshold_data, f)&amp;#10;    print(f&quot;Final threshold angle saved for participant {participant}: {threshold_angle:.2f} degrees ({threshold_file})&quot;)&amp;#10;else:&amp;#10;    print(f&quot;Session {session} complete - threshold not saved (only session 3 saves the final threshold). Current estimate: {threshold_angle:.2f} degrees&quot;)&amp;#10;&amp;#10;# Descriptive summary for this session&amp;#10;accuracy_history = expInfo.get('accuracy_history', [])&amp;#10;total_trials_completed = len(accuracy_history)&amp;#10;total_correct = sum(accuracy_history)&amp;#10;overall_accuracy = (total_correct / total_trials_completed * 100) if total_trials_completed &gt; 0 else 0&amp;#10;&amp;#10;final_window = 20&amp;#10;recent = accuracy_history[-final_window:]&amp;#10;final_rolling_accuracy = (sum(recent) / len(recent) * 100) if len(recent) &gt; 0 else 0&amp;#10;&amp;#10;n_reversals = len(stair.reversalIntensities)&amp;#10;&amp;#10;print(f&quot;\n{'='*50}&quot;)&amp;#10;print(f&quot;SESSION {session} SUMMARY&quot;)&amp;#10;print(f&quot;{'='*50}&quot;)&amp;#10;print(f&quot;Total trials completed: {total_trials_completed}&quot;)&amp;#10;print(f&quot;Total no-response trials: {noresp_count}&quot;)&amp;#10;print(f&quot;Total correct: {total_correct}&quot;)&amp;#10;print(f&quot;Overall accuracy: {overall_accuracy:.1f}%&quot;)&amp;#10;print(f&quot;Final rolling accuracy (last {len(recent)} trials): {final_rolling_accuracy:.1f}%&quot;)&amp;#10;print(f&quot;Number of staircase reversals: {n_reversals}&quot;)&amp;#10;print(f&quot;Final threshold estimate: {threshold_angle:.2f} degrees&quot;)&amp;#10;print(f&quot;{'='*50}\n&quot;)" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_7" valType="code" updates="None" name="name"/>
      </CodeComponent>
