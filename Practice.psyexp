        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="if ((valid === 1)) {&amp;#10;    stimLoc = cueDir;&amp;#10;} else {&amp;#10;    stimLoc = ((cueDir === &quot;left&quot;) ? &quot;right&quot; : &quot;left&quot;);&amp;#10;}&amp;#10;stimPos = ((stimLoc === &quot;left&quot;) ? [(- 5), 0] : [5, 0]);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if valid == 1:&amp;#10;    stimLoc = cueDir&amp;#10;else:&amp;#10;    stimLoc = 'right' if cueDir == 'left' else 'left'&amp;#10;&amp;#10;stimPos = (-0.5, 0) if stimLoc == 'left' else (0.5, 0)&amp;#10;gabor_angle = level * tiltDir&amp;#10;gabor.ori = gabor_angle&amp;#10;gabor.setPos(stimPos)&amp;#10;gabor.sf = 5" valType="extendedCode" updates="constant" name="Begin Routine"/>
