    <EyetrackerCalibrationRoutine name="eye_calibration"/>
    <Routine name="instructions"/>
    <LoopInitiator loopType="TrialHandler" name="trials">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('cueDir', 'left'), ('valid', np.int64(1)), ('trialType', 'valid_left'), ('corr_response', '1'), ('tiltDir', np.int64(1))]), OrderedDict([('cueDir', 'left'), ('valid', np.int64(1)), ('trialType', 'valid_left'), ('corr_response', '2'), ('tiltDir', np.int64(-1))]), OrderedDict([('cueDir', 'right'), ('valid', np.int64(1)), ('trialType', 'valid_right'), ('corr_response', '1'), ('tiltDir', np.int64(1))]), OrderedDict([('cueDir', 'right'), ('valid', np.int64(1)), ('trialType', 'valid_right'), ('corr_response', '2'), ('tiltDir', np.int64(-1))])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="$practice_trial_list_file" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
