      <CodeComponent name="code_4" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="staircase_name.addResponse(corr);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="if str(key_resp.keys) == str(corr_response):&amp;#10;    key_resp.corr = 1&amp;#10;else:&amp;#10;    key_resp.corr = 0&amp;#10;&amp;#10;if key_resp.keys in ['', [], None]:&amp;#10;    noresp_count += 1&amp;#10;&amp;#10;stair.addResponse(key_resp.corr)&amp;#10;&amp;#10;# Update level for next trial&amp;#10;try:&amp;#10;    level = next(stair)&amp;#10;except StopIteration:&amp;#10;    level = stair.mean()&amp;#10;    &amp;#10;    # Track rolling accuracy&amp;#10;if 'accuracy_history' not in expInfo:&amp;#10;    expInfo['accuracy_history'] = []&amp;#10;&amp;#10;expInfo['accuracy_history'].append(key_resp.corr)&amp;#10;&amp;#10;# Check stopping criteria after minimum trials&amp;#10;min_trials = 60&amp;#10;window_size = 20&amp;#10;tolerance = 0.07&amp;#10;target = 0.7&amp;#10;&amp;#10;if trials.thisN &gt;= min_trials:&amp;#10;    recent = expInfo['accuracy_history'][-window_size:]&amp;#10;    rolling_acc = sum(recent) / len(recent)&amp;#10;    &amp;#10;    print(f&quot;Trial {trials.thisN}: Rolling accuracy = {rolling_acc:.2f}&quot;)&amp;#10;    &amp;#10;    n_reversals = len(stair.reversalIntensities)&amp;#10;    &amp;#10;    if (abs(rolling_acc - target) &lt;= tolerance and n_reversals &gt;= 6):&amp;#10;        print(f&quot;Stopping criteria met at trial {trials.thisN}!&quot;)&amp;#10;        print(f&quot;Rolling accuracy: {rolling_acc:.2f}, Reversals: {n_reversals}&quot;)&amp;#10;        trials.finished = True  # this ends the trials loop early&amp;#10;&amp;#10;thisExp.addData('gabor_angle', gabor_angle)&amp;#10;thisExp.addData('level', level)&amp;#10;thisExp.addData('jitter', jitter)&amp;#10;thisExp.addData('tiltDir', tiltDir)&amp;#10;thisExp.addData('key_resp.corr', key_resp.corr)&amp;#10;&amp;#10;# Running threshold estimate, saved every trial (not just at the end) so it&amp;#10;# is captured even if the run is closed before the experiment finishes&amp;#10;if len(stair.reversalIntensities) &gt;= 2:&amp;#10;    threshold_angle_estimate = np.mean(stair.reversalIntensities[-6:])&amp;#10;else:&amp;#10;    threshold_angle_estimate = level&amp;#10;thisExp.addData('threshold_angle_estimate', threshold_angle_estimate)&amp;#10;&amp;#10;# Running session summary, saved every trial for the same reason&amp;#10;total_trials_completed = len(expInfo['accuracy_history'])&amp;#10;total_correct = sum(expInfo['accuracy_history'])&amp;#10;overall_accuracy = (total_correct / total_trials_completed * 100) if total_trials_completed &gt; 0 else 0&amp;#10;final_window = 20&amp;#10;recent = expInfo['accuracy_history'][-final_window:]&amp;#10;final_rolling_accuracy = (sum(recent) / len(recent) * 100) if len(recent) &gt; 0 else 0&amp;#10;n_reversals = len(stair.reversalIntensities)&amp;#10;&amp;#10;thisExp.addData('total_trials_completed', total_trials_completed)&amp;#10;thisExp.addData('total_correct', total_correct)&amp;#10;thisExp.addData('total_noresp', noresp_count)&amp;#10;thisExp.addData('overall_accuracy', overall_accuracy)&amp;#10;thisExp.addData('final_rolling_accuracy', final_rolling_accuracy)&amp;#10;thisExp.addData('n_reversals', n_reversals)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_4" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
